{
  "manifest_version": 3,
  "name": "Nightfall",
  "version": "1.1.0",
  "description": "Soft dark mode with saved per-site or global preferences. No tracking or external services.",
  "minimum_chrome_version": "102",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "css": ["dark.css"],
    "js": ["settings.js", "content.js"],
    "run_at": "document_start"
  }],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Nightfall — click to turn on" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
